<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= community.customerName %> - Support Tickets</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/community.css">
    <style>
        body {
            margin: 0;
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: linear-gradient(180deg, #eef2ff 0%, #f8fafc 45%, #ffffff 100%);
            color: #0f172a;
        }

        .community-main {
            flex: 1;
            min-height: 100vh;
            padding: 20px 20px 24px;
            background: transparent;
        }

        .tickets-top-bar {
            display: flex;
            justify-content: space-between;
            gap: 18px;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 18px;
            padding: 18px 22px;
            border-radius: 24px;
            background: rgba(255,255,255,0.95);
            border: 1px solid rgba(148, 163, 184, 0.14);
            box-shadow: 0 16px 35px rgba(15, 23, 42, 0.09);
            backdrop-filter: blur(10px);
        }

        .tickets-top-bar h1 {
            font-size: 32px;
            margin: 0;
            color: #0f172a;
        }

        .tickets-top-bar p {
            margin: 8px 0 0;
            color: #475569;
            font-size: 14px;
            line-height: 1.7;
            max-width: 600px;
        }

        .btn-refresh {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 18px;
            border: 1px solid #cbd5e1;
            border-radius: 12px;
            background: white;
            color: #0f172a;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);
        }

        .btn-refresh:hover {
            background: #eff6ff;
            border-color: #93c5fd;
            transform: translateY(-1px);
        }

        .tickets-summary {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 20px;
        }

        .summary-card {
            background: white;
            border-radius: 18px;
            padding: 20px 22px;
            box-shadow: 0 16px 36px rgba(15, 23, 42, 0.07);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
            position: relative;
            overflow: hidden;
        }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 26px 64px rgba(15, 23, 42, 0.14);
        }

        .summary-card.open {
            background: linear-gradient(135deg, #dbeafe, #eff6ff);
        }

        .summary-card.in-progress {
            background: linear-gradient(135deg, #fef9c3, #fde68a);
        }

        .summary-card.resolved {
            background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        }

        .summary-label {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #475569;
            margin-bottom: 12px;
        }

        .summary-value {
            font-size: 36px;
            font-weight: 800;
            margin: 0;
            color: #0f172a;
        }

        .summary-note {
            margin-top: 10px;
            color: #64748b;
            font-size: 13px;
            line-height: 1.7;
        }

        .tickets-card {
            background: rgba(255,255,255,0.95);
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 24px 70px rgba(15, 23, 42, 0.11);
            border: 1px solid rgba(148, 163, 184, 0.14);
        }

        .tickets-card-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 14px;
            padding: 20px 22px;
            border-bottom: 1px solid rgba(148, 163, 184, 0.12);
            background: linear-gradient(90deg, rgba(255,255,255,0.95), rgba(240,249,255,0.95));
        }

        .tickets-card-header h2 {
            font-size: 22px;
            margin: 0;
        }

        .tickets-card-header p {
            margin: 8px 0 0;
            color: #64748b;
            font-size: 14px;
            max-width: 520px;
            line-height: 1.7;
        }

        .tickets-table-wrapper {
            overflow-x: auto;
            min-width: 100%;
        }

        .tickets-table {
            width: 100%;
            min-width: 0;
            border-collapse: separate;
            border-spacing: 0 8px;
            font-size: 14px;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 14px 12px;
            text-align: left;
            vertical-align: middle;
        }

        .tickets-table th {
            background: #ffffff;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #334155;
            border-bottom: 1px solid rgba(148, 163, 184, 0.18);
        }

        .tickets-table tbody tr {
            background: white;
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.05);
            border-radius: 18px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .tickets-table tbody tr:hover {
            background: #f8fbff;
            transform: translateY(-1px);
            box-shadow: 0 16px 40px rgba(15, 23, 42, 0.1);
            cursor: pointer;
        }

        .tickets-table tbody tr td {
            border-bottom: none;
        }

        .ticket-title {
            font-weight: 700;
            color: #0f172a;
            display: block;
            margin-bottom: 6px;
        }

        .ticket-device {
            color: #475569;
            font-size: 13px;
            line-height: 1.6;
        }

        .ticket-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            text-transform: capitalize;
        }

        .ticket-badge.low {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .ticket-badge.medium {
            background: #fde68a;
            color: #92400e;
        }

        .ticket-badge.high {
            background: #fecaca;
            color: #991b1b;
        }

        .ticket-badge.critical {
            background: #fecdd3;
            color: #9d174d;
        }

        .ticket-badge.open {
            background: #fee2e2;
            color: #b91c1c;
        }

        .ticket-badge.acknowledged {
            background: #fef3c7;
            color: #92400e;
        }

        .ticket-badge.resolved,
        .ticket-badge.closed {
            background: #dcfce7;
            color: #166534;
        }

        .no-tickets {
            text-align: center;
            padding: 48px 0;
            color: #64748b;
            font-size: 15px;
        }

        .device-modal {
            display: none;
            position: fixed;
            inset: 0;
            padding: 24px;
            background: rgba(15, 23, 42, 0.4);
            backdrop-filter: blur(4px);
            z-index: 1000;
        }

        .device-modal-content {
            background: white;
            border-radius: 20px;
            max-width: 620px;
            margin: 0 auto;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 24px 80px rgba(15, 23, 42, 0.18);
            animation: slideInUp 0.3s ease;
        }

        .device-modal-header {
            padding: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e2e8f0;
        }

        .device-modal-title {
            font-size: 20px;
            margin: 0;
        }

        .device-modal-close {
            background: none;
            border: none;
            font-size: 26px;
            cursor: pointer;
            color: #64748b;
        }

        .device-modal-close:hover {
            color: #0f172a;
        }

        .device-modal-body {
            padding: 24px;
        }

        .device-detail {
            display: grid;
            grid-template-columns: 160px 1fr;
            gap: 10px 24px;
            margin-bottom: 18px;
        }

        .device-detail-label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #64748b;
        }

        .device-detail-value {
            font-size: 15px;
            color: #0f172a;
            font-weight: 600;
        }

        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(24px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 960px) {
            .tickets-summary {
                grid-template-columns: 1fr;
            }

            .tickets-top-bar,
            .tickets-card-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .tickets-table {
                min-width: 760px;
            }

            .device-detail {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <aside class="community-sidebar">
        <a href="#" class="community-sidebar-header">
            <span style="font-size: 24px;">🏘️</span>
            <h2>Megha Smart</h2>
        </a>

        <nav class="community-menu">
            <a href="/community/dashboard" class="community-menu-item">
                <span class="icon">📊</span>
                <span>Dashboard</span>
            </a>
            <a href="/community/devices" class="community-menu-item">
                <span class="icon">📡</span>
                <span>Devices</span>
            </a>
            <a href="/community/tickets" class="community-menu-item active">
                <span class="icon">🎫</span>
                <span>Support Tickets</span>
            </a>
            <a href="/community/profile" class="community-menu-item">
                <span class="icon">👤</span>
                <span>Profile</span>
            </a>
            <% if (community.email === 'customer8@meghasmart.com' || community.email === 'customer9@meghasmart.com') { %>
                <a href="/community/reports" class="community-menu-item">
                    <span class="icon">📈</span>
                    <span>Reports</span>
                </a>
            <% } %>
        </nav>

        <div class="community-sidebar-footer">
            <a href="/community/logout" class="community-logout-btn">
                <span class="icon">🚪</span>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <div class="community-main">
        <div class="tickets-top-bar">
            <div>
                <h1>Tickets / Alerts</h1>
            </div>
            <button class="btn-refresh" onclick="reloadTickets()">Refresh</button>
        </div>

        <div class="tickets-summary">
            <div class="summary-card open">
                <div class="summary-label">Open Tickets</div>
                <p class="summary-value" id="openCount">0</p>
                <p class="summary-note">Active issues requiring immediate attention.</p>
            </div>
            <div class="summary-card in-progress">
                <div class="summary-label">In Progress</div>
                <p class="summary-value" id="acknowledgedCount">0</p>
                <p class="summary-note">Tickets currently assigned or under investigation.</p>
            </div>
            <div class="summary-card resolved">
                <div class="summary-label">Resolved</div>
                <p class="summary-value" id="completedCount">0</p>
                <p class="summary-note">Tickets that have been successfully closed.</p>
            </div>
        </div>

        <div class="tickets-card">
            <div class="tickets-card-header">
                <div>
                    <h2>Community Tickets</h2>
                </div>
            </div>
            <div class="tickets-table-wrapper">
                <table class="tickets-table">
                    <thead>
                        <tr>
                            <th>Ticket</th>
                            <th>Device</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assigned</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody id="ticketsTableBody"></tbody>
                </table>
            </div>
        </div>

        <div id="deviceModal" class="device-modal">
            <div class="device-modal-content">
                <div class="device-modal-header">
                    <h2 class="device-modal-title">Device Details</h2>
                    <button class="device-modal-close" onclick="closeDeviceModal()">&times;</button>
                </div>
                <div class="device-modal-body" id="deviceModalBody"></div>
            </div>
        </div>
    </div>

    <script>
        const devicesData = <%- JSON.stringify(devices) %>;
        const communityData = <%- JSON.stringify(community) %>;

        function seededRandom(seed) {
            const x = Math.sin(seed) * 10000;
            return x - Math.floor(x);
        }

        function hashDeviceId(deviceId) {
            let hash = 0;
            for (let i = 0; i < deviceId.length; i++) {
                hash = ((hash << 5) - hash) + deviceId.charCodeAt(i);
                hash |= 0;
            }
            return Math.abs(hash);
        }

        function generateTicketsFromDevices() {
            const issues = [
                'Sensor not responding',
                'Calibration required',
                'Battery replacement needed',
                'Connectivity issue',
                'False positive detection',
                'Maintenance check required',
                'Temperature reading inconsistent',
                'Humidity alert',
                'System health check',
                'Configuration update needed'
            ];

            const tickets = [];
            let ticketId = 1;

            devicesData.forEach(device => {
                let ticketStatus = 'open';
                let priority = 'medium';

                switch (device.status) {
                    case 1:
                        ticketStatus = 'acknowledged';
                        priority = 'low';
                        break;
                    case 2:
                        ticketStatus = 'acknowledged';
                        priority = 'medium';
                        break;
                    case 3:
                        ticketStatus = 'open';
                        priority = 'high';
                        break;
                    case 4:
                        ticketStatus = 'resolved';
                        priority = 'low';
                        break;
                    default:
                        ticketStatus = 'open';
                        priority = 'medium';
                }

                const deviceHash = hashDeviceId(device.deviceId);
                const issueIndex = Math.floor(seededRandom(deviceHash) * issues.length);
                const issue = issues[issueIndex];
                const daysAgo = ticketStatus === 'resolved'
                    ? Math.floor(seededRandom(deviceHash * 2) * 30)
                    : Math.floor(seededRandom(deviceHash * 2) * 7);

                const createdDate = new Date();
                createdDate.setDate(createdDate.getDate() - daysAgo);

                tickets.push({
                    id: `TKT-${String(ticketId).padStart(3, '0')}`,
                    title: `${device.sensorType} — ${issue}`,
                    device: `${device.deviceId} (${device.sensorType})`,
                    deviceId: device.deviceId,
                    status: ticketStatus,
                    priority,
                    created: createdDate.toISOString().split('T')[0]
                });

                ticketId++;
            });

            return tickets;
        }

        const ticketsData = generateTicketsFromDevices();

        function formatDate(dateStr) {
            const date = new Date(dateStr);
            return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        function renderSummary() {
            document.getElementById('openCount').textContent = ticketsData.filter(ticket => ticket.status === 'open').length;
            document.getElementById('acknowledgedCount').textContent = ticketsData.filter(ticket => ticket.status === 'acknowledged').length;
            document.getElementById('completedCount').textContent = ticketsData.filter(ticket => ticket.status === 'resolved' || ticket.status === 'closed').length;
        }

        function renderTicketsTable(tickets) {
            const body = document.getElementById('ticketsTableBody');
            if (!body) return;

            if (!tickets.length) {
                body.innerHTML = '<tr><td colspan="6" class="no-tickets">No tickets are available for this community.</td></tr>';
                return;
            }

            body.innerHTML = tickets.map(ticket => `
                <tr onclick="showDeviceDetails('${ticket.deviceId}')">
                    <td>
                        <span class="ticket-title">${ticket.id} — ${ticket.title}</span>
                        <span class="ticket-device">${ticket.device}</span>
                    </td>
                    <td>${ticket.deviceId}</td>
                    <td><span class="ticket-badge ${ticket.priority}">${ticket.priority}</span></td>
                    <td><span class="ticket-badge ${ticket.status}">${ticket.status}</span></td>
                    <td>-</td>
                    <td>${formatDate(ticket.created)}</td>
                </tr>
            `).join('');
        }

        function showDeviceDetails(deviceId) {
            const device = devicesData.find(d => d.deviceId === deviceId);
            if (!device) return;

            const modalBody = document.getElementById('deviceModalBody');
            modalBody.innerHTML = `
                <div class="device-detail">
                    <div class="device-detail-label">Device ID</div>
                    <div class="device-detail-value">${device.deviceId}</div>
                </div>
                <div class="device-detail">
                    <div class="device-detail-label">Sensor Type</div>
                    <div class="device-detail-value">${device.sensorType}</div>
                </div>
                <div class="device-detail">
                    <div class="device-detail-label">Flat Number</div>
                    <div class="device-detail-value">${device.flatNo}</div>
                </div>
                <div class="device-detail">
                    <div class="device-detail-label">Status</div>
                    <div class="device-detail-value">${device.status}</div>
                </div>
                <div class="device-detail">
                    <div class="device-detail-label">Community</div>
                    <div class="device-detail-value">${communityData.customerName}</div>
                </div>
            `;
            document.getElementById('deviceModal').style.display = 'block';
        }

        function closeDeviceModal() {
            document.getElementById('deviceModal').style.display = 'none';
        }

        function reloadTickets() {
            renderSummary();
            renderTicketsTable(ticketsData);
        }

        document.addEventListener('DOMContentLoaded', () => {
            reloadTickets();
            document.getElementById('deviceModal').addEventListener('click', event => {
                if (event.target.id === 'deviceModal') {
                    closeDeviceModal();
                }
            });
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    closeDeviceModal();
                }
            });
        });
    </script>
    <%- include('community-alert-popup') %>
</body>
</html>
