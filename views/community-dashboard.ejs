    <!-- Sidebar and header toggle -->
    <!-- SIDEBAR -->
    <aside class="community-sidebar" id="community-sidebar">
        <div class="community-sidebar-header" style="display: flex; align-items: center; gap: 10px; padding: 18px 18px 18px 18px; border-bottom: 1px solid rgba(255,255,255,0.08);">
