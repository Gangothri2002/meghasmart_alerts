    <!-- MAIN CONTENT -->
    <div class="community-main" id="community-main">
            <script>
                // Sidebar enlarge/small toggle functionality for community dashboard
                const sidebar = document.getElementById('community-sidebar');
                const mainContent = document.getElementById('community-main');
                const toggleBtn = document.getElementById('sidebar-toggle-btn');
                const toggleIcon = document.getElementById('sidebar-toggle-icon');
                const floatToggle = document.getElementById('sidebar-float-toggle');
                let sidebarCollapsed = false;
                function setSidebarState(collapsed) {
                    sidebarCollapsed = collapsed;
                    if (sidebarCollapsed) {
                        sidebar.classList.add('sidebar-collapsed');
                        mainContent.classList.add('main-content-expanded');
                        toggleIcon.innerHTML = '&#9635;'; // Square icon
                        floatToggle.style.display = 'block';
                    } else {
                        sidebar.classList.remove('sidebar-collapsed');
                        mainContent.classList.remove('main-content-expanded');
                        toggleIcon.innerHTML = '&#9776;'; // Hamburger icon
                        floatToggle.style.display = 'none';
                    }
                }
                if (toggleBtn && sidebar && mainContent && toggleIcon && floatToggle) {
                    toggleBtn.addEventListener('click', function () {
                        setSidebarState(!sidebarCollapsed);
                    });
                    floatToggle.addEventListener('click', function () {
                        setSidebarState(false);
                    });
                }
            </script>
        <div class="community-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: flex-start; gap: 8px;">
                <button id="sidebar-float-toggle" title="Show Sidebar" style="display:none; background: transparent; border: none; color: #23284a; font-size: 1.2em; cursor: pointer; padding: 0; width: 28px; height: 28px; border-radius: 0; box-shadow: none; align-items: center; justify-content: center; transition: color 0.2s; position: relative;">
                    <span style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; font-size: 1.2em;"><span style="margin-top:2px;">&#9776;</span></span>
                    <span class="toggle-tooltip" style="display:none; position: absolute; left: 26px; top: 50%; transform: translateY(-50%); background: #23284a; color: #fff; font-size: 11px; padding: 3px 8px; border-radius: 6px; white-space: nowrap; box-shadow: 0 2px 8px rgba(30,41,59,0.13);">Show Menu</span>
                </button>
                <h1 style="margin-top: 28px;">📡 Community Devices</h1>
            </div>
            
            <!-- ALERT POPUP AT CENTER -->
            <div class="header-center-popup">
                <div id="alertPopup" class="alert-popup" style="display: none; cursor: pointer;" onclick="handleAlertClick()">
                    <span class="alert-icon">🔴</span>
                    <span class="alert-text"><span id="alertText">Alert Device</span>, Flat No: <span id="alertFlatNo"></span></span>
                </div>
            </div>
            
            <!-- PROFILE MENU -->
            <div class="profile-menu-container">
                <button class="profile-trigger" onclick="toggleProfileMenu(event)">
                    <div class="profile-avatar"><%= community.customerName.charAt(0).toUpperCase() %></div>
                    <div style="text-align: left;">
                        <div style="font-size: 12px; color: #9ca3af;">Account</div>
                        <div class="profile-email"><%= community.email || community.customerName %></div>
                    </div>
                    <span style="margin-left: auto; font-size: 18px;">▼</span>
                </button>

                <div class="profile-dropdown" id="profileDropdown">
                    <a href="/community/profile" class="profile-dropdown-item">
                        <span>👤</span>
                        <span>Edit profile</span>
                    </a>
                    <a href="/community/profile" class="profile-dropdown-item">
                        <span>⚙️</span>
                        <span>Account settings</span>
                    </a>
                    <a href="#" class="profile-dropdown-item">
                        <span>❓</span>
                        <span>Support</span>
                    </a>
                    <a href="/community/logout" class="profile-dropdown-item danger">
                        <span>🔓</span>
                        <span>Sign out</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- DEVICES SECTION -->
        <div class="community-card dashboard-card">
            <div class="search-filter-bar">
                <input 
                    type="text" 
                    id="dashboardSearch" 
                    placeholder="Search device name or ID" 
                />
                <div class="device-count-inline">Total Devices: <strong><%= devices.length %></strong></div>
                <select id="statusFilter" onchange="filterDevices()">
                    <option value="">All Status</option>
                    <option value="1">Initialize</option>
                    <option value="2">No Communication</option>
                    <option value="4">Good</option>
                    <option value="3">Alert</option>
                    <option value="5">Panic Alert</option>
                </select>
            </div>
            <div class="devices-container">
                <% if (devices && devices.length > 0) { %>
                    <div class="carousel-container">
                        <div class="carousel-wrapper" id="carouselWrapper">
                            <%
                            const devicesPerPage = 98;
                            const totalPages = Math.ceil(devices.length / devicesPerPage);
                            for (let page = 0; page < totalPages; page++) {
                                const startIndex = page * devicesPerPage;
                                const endIndex = Math.min(startIndex + devicesPerPage, devices.length);
                                const pageDevices = devices.slice(startIndex, endIndex);
                            %>
                                <div class="carousel-slide <%= page === 0 ? 'active' : '' %>" data-page="<%= page %>">
                                    <div class="devices-grid">
                                        <% pageDevices.forEach(device => {
                                            const statusKey = device.status;
                                            const statusLabel = statusMapping.getStatusLabel(statusKey);
                                            const statusClass = statusMapping.getStatusClass(statusKey);
                                        %>
                                            <div class="device-card <%= statusClass %>" data-status="<%= statusKey %>" data-statustext="<%= statusLabel %>" data-flatno="<%= device.flatNo %>" data-deviceid="<%= device.deviceId %>">
                                                <div class="device-circle-content">
                                                    <%= device.flatNo %>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                        <% if (totalPages > 1) { %>
                            <div class="carousel-indicators">
                                <% for (let i = 0; i < totalPages; i++) { %>
                                    <span class="indicator <%= i === 0 ? 'active' : '' %>" data-page="<%= i %>"></span>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <div style="font-size: 80px; margin-bottom: 16px; opacity: 0.6;">📭</div>
                        <h3 style="color: #1f2937; margin-bottom: 8px; font-size: 20px; font-weight: 700;">No devices assigned yet</h3>
                        <p style="color: #6b7280; font-size: 14px; margin-bottom: 24px; line-height: 1.6;">You don't have any devices assigned to your community. Please contact your administrator to add devices to your account.</p>
                        <a href="/community/devices" class="btn btn-gradient">Browse All Devices</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        let currentSlide = 0;
        let totalSlides = 0;
        let carouselInterval;
        let previousAlertCount = 0;
        let hasExistingTicket = false;
        let alertTicketId = null;
        let buzzerTimeout = null;

        function playBuzzer() {
            const buzzerAudio = document.getElementById('buzzerAudio');
            if (!buzzerAudio) return;

            buzzerAudio.currentTime = 0;
            buzzerAudio.play().catch(() => {});

            if (buzzerTimeout) {
                clearTimeout(buzzerTimeout);
            }
            buzzerTimeout = setTimeout(() => {
                if (buzzerAudio && !buzzerAudio.paused) {
                    buzzerAudio.pause();
                    buzzerAudio.currentTime = 0;
                }
                buzzerTimeout = null;
            }, 6000);
        }

        function stopBuzzer() {
            const buzzerAudio = document.getElementById('buzzerAudio');
            if (buzzerTimeout) {
                clearTimeout(buzzerTimeout);
                buzzerTimeout = null;
            }
            if (buzzerAudio && !buzzerAudio.paused) {
                buzzerAudio.pause();
                buzzerAudio.currentTime = 0;
            }
        }

        // Handle alert popup click
        function handleAlertClick() {
            const alertDevices = document.querySelectorAll('.device-card[data-status="3"], .device-card[data-status="5"]');
            
            if (alertDevices.length > 0) {
                // Check if new alert devices appeared
                if (alertDevices.length > previousAlertCount) {
                    // New alert devices - create new ticket
                    createNewAlertTicket();
                } else {
                    // Same or existing alert - open existing ticket
                    if (alertTicketId) {
                        // Open existing ticket
                        window.location.href = `/community/tickets`;
                    } else {
                        // No ticket yet, create new one
                        createNewAlertTicket();
                    }
                }
            }
        }

        // Create new alert ticket
        function createNewAlertTicket() {
            const alertDevices = document.querySelectorAll('.device-card[data-status="3"], .device-card[data-status="5"]');
            const deviceList = Array.from(alertDevices).map(card => ({
                flatNo: card.getAttribute('data-flatno'),
                deviceId: card.getAttribute('data-deviceid')
            }));

            // Get alert device details
            const deviceDetails = deviceList.map(d => `${d.flatNo} (${d.deviceId})`).join(', ');
            
            // Create ticket via API
            fetch('/api/community/tickets', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                credentials: 'same-origin',
                body: JSON.stringify({
                    subject: `Alert Devices - ${deviceList.length} device(s)`,
                    description: `${deviceList.length} device(s) showing alert status: ${deviceDetails}`,
                    priority: 'high',
                    alertDevices: deviceList
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.ticketId) {
                    alertTicketId = data.ticketId;
                    hasExistingTicket = true;
                    // Redirect to tickets page after creating
                    window.location.href = `/community/tickets`;
                }
                console.log('Ticket created:', data);
            })
            .catch(error => {
                console.error('Error creating ticket:', error);
                // If API fails, just navigate to tickets
                window.location.href = `/community/tickets`;
            });
        }

        // Initialize carousel
        function initCarousel() {
            if (totalSlides <= 1) return;

            // Start automatic sliding
            carouselInterval = setInterval(() => {
                nextSlide();
            }, 3000);
        }

        // Show specific slide
        function showSlide(slideIndex) {
            const slides = document.querySelectorAll('.carousel-slide');
            const indicators = document.querySelectorAll('.indicator');

            // Hide all slides
            slides.forEach(slide => slide.classList.remove('active'));
            indicators.forEach(indicator => indicator.classList.remove('active'));

            // Show current slide
            slides[slideIndex].classList.add('active');
            indicators[slideIndex].classList.add('active');

            currentSlide = slideIndex;
        }

        // Next slide
        function nextSlide() {
            const nextIndex = (currentSlide + 1) % totalSlides;
            showSlide(nextIndex);
        }

        // Previous slide
        function prevSlide() {
            const prevIndex = (currentSlide - 1 + totalSlides) % totalSlides;
            showSlide(prevIndex);
        }

        // Handle indicator clicks
        document.addEventListener('click', function(e) {
            if (e.target.classList.contains('indicator')) {
                const page = parseInt(e.target.getAttribute('data-page'));
                showSlide(page);
                // Reset timer
                clearInterval(carouselInterval);
                carouselInterval = setInterval(() => {
                    nextSlide();
                }, 3000);
            }
        });

        // Profile menu toggle
        function toggleProfileMenu(event) {
            event.preventDefault();
            const dropdown = document.getElementById('profileDropdown');
            dropdown.classList.toggle('active');
        }

        // Close profile dropdown when clicking outside
        document.addEventListener('click', function(e) {
            const dropdown = document.getElementById('profileDropdown');
            const trigger = document.querySelector('.profile-trigger');
            if (trigger && dropdown && !e.target.closest('.profile-menu-container')) {
                dropdown.classList.remove('active');
            }
        });

        // Filter and search functionality
        function filterDevices() {
            const searchTerm = document.getElementById('dashboardSearch').value.toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value;
            const deviceCards = document.querySelectorAll('.device-card');
            let visibleDevices = [];

            deviceCards.forEach(card => {
                const flatNo = card.getAttribute('data-flatno').toLowerCase();
                const deviceId = card.getAttribute('data-deviceid').toLowerCase();
                const status = card.getAttribute('data-status');

                const matchesSearch = flatNo.includes(searchTerm) || deviceId.includes(searchTerm);
                const matchesStatus = !statusFilter || status === statusFilter;

                if (matchesSearch && matchesStatus) {
                    card.style.display = '';
                    visibleDevices.push(card);
                } else {
                    card.style.display = 'none';
                }
            });

            // If filtering is active, show all slides to display filtered results
            const slides = document.querySelectorAll('.carousel-slide');
            const indicators = document.querySelectorAll('.indicator');

            if (searchTerm || statusFilter) {
                // Show all slides when filtering
                slides.forEach(slide => slide.classList.add('active'));
                indicators.forEach(indicator => indicator.classList.remove('active'));
                clearInterval(carouselInterval);
            } else {
                // Resume carousel when no filters
                slides.forEach((slide, index) => {
                    if (index === 0) {
                        slide.classList.add('active');
                    } else {
                        slide.classList.remove('active');
                    }
                });
                indicators.forEach((indicator, index) => {
                    if (index === 0) {
                        indicator.classList.add('active');
                    } else {
                        indicator.classList.remove('active');
                    }
                });
                currentSlide = 0;
                totalSlides = document.querySelectorAll('.carousel-slide').length;
                if (totalSlides > 1) {
                    clearInterval(carouselInterval);
                    carouselInterval = setInterval(() => {
                        nextSlide();
                    }, 3000);
                }
            }
        }

        // Search input listener
        document.getElementById('dashboardSearch').addEventListener('input', filterDevices);

        // Auto-refresh community dashboard every 3 seconds
        function updateCommunityDashboard() {
            fetch('/api/community/dashboard/stats', {
                method: 'GET',
                headers: {
                    'Content-Type': 'application/json',
                },
                credentials: 'same-origin' // Include session cookies
            })
            .then(response => response.json())
            .then(data => {
                // Update device cards with new status
                data.devices.forEach(device => {
                    const deviceCard = document.querySelector(`.device-card[data-deviceid="${device.deviceId}"]`);
                    if (deviceCard) {
                        // Update status attribute and label metadata
                        deviceCard.setAttribute('data-status', device.status);
                        const statusConfig = getStatusConfig(device.status);
                        deviceCard.dataset.statustext = statusConfig.label;

                        // Update status classes
                        deviceCard.classList.remove('status-online', 'status-good', 'status-alert', 'status-panic', 'status-offline', 'status-no-communication', 'status-initialize');

                        // Add new status class based on device status
                        switch(device.status) {
                            case 1:
                                deviceCard.classList.add('status-initialize');
                                break;
                            case 2:
                                deviceCard.classList.add('status-no-communication');
                                break;
                            case 3:
                                deviceCard.classList.add('status-alert');
                                break;
                            case 5:
                                deviceCard.classList.add('status-panic');
                                break;
                            case 4:
                                deviceCard.classList.add('status-online');
                                break;
                        }

                        // Update status badge text if present
                        const statusBadge = deviceCard.querySelector('.device-status-badge');
                        if (statusBadge) {
                            statusBadge.innerHTML = `${statusConfig.icon} ${statusConfig.label}`;
                        }
                    }
                });

                // Check for alert devices and show/hide popup
                const alertDevices = data.devices.filter(device => device.status === 3 || device.status === 5);
                const alertPopup = document.getElementById('alertPopup');
                const alertFlatNo = document.getElementById('alertFlatNo');
                if (alertPopup && alertFlatNo) {
                    const currentCount = alertDevices.length;
                    
                    if (currentCount > 0) {
                        // Display first alert device's flat number and status label
                        const firstAlertDevice = alertDevices[0];
                        alertFlatNo.textContent = firstAlertDevice.flatNo || '';
                        const statusConfig = getStatusConfig(firstAlertDevice.status);
                        const statusText = statusConfig.label || 'Alert';
                        const alertTextElement = document.getElementById('alertText');
                        if (alertTextElement) {
                            alertTextElement.textContent = `${statusText} Device`;
                        }
                        
                        // Check if this is a new alert
                        if (currentCount > previousAlertCount) {
                            hasExistingTicket = false;
                            alertTicketId = null;
                        }
                        previousAlertCount = currentCount;
                        alertPopup.style.display = 'flex';
                        // Play buzzer sound when popup is shown
                        playBuzzer();
                    } else {
                        previousAlertCount = 0;
                        hasExistingTicket = false;
                        alertTicketId = null;
                        alertPopup.style.display = 'none';
                        // Stop buzzer sound when popup is hidden
                        stopBuzzer();
                    }
                }

                // Also check DOM for consistency
                checkAlertDevices();

                // Update statistics if they exist
                const totalDevicesEl = document.querySelector('.stat-value[data-stat="total"]');
                const onlineDevicesEl = document.querySelector('.stat-value[data-stat="online"]');
                const alertDevicesEl = document.querySelector('.stat-value[data-stat="alert"]');

                if (totalDevicesEl) totalDevicesEl.textContent = data.stats.totalDevices;
                if (onlineDevicesEl) onlineDevicesEl.textContent = data.stats.onlineDevices;
                if (alertDevicesEl) alertDevicesEl.textContent = data.stats.alertDevices;

                console.log('Community dashboard updated:', data.stats);
            })
            .catch(error => {
                console.error('Error updating community dashboard:', error);
            });
        }

        // Helper function to get status configuration
        function getStatusConfig(status) {
            const configs = {
                1: { label: 'Initialize', icon: '🔵', color: '#3b82f6' },
                2: { label: 'No Communication', icon: '🟡', color: '#f59e0b' },
                3: { label: 'Alert', icon: '🔴', color: '#ef4444' },
                4: { label: 'Good', icon: '🟢', color: '#10b981' },
                5: { label: 'Panic Alert', icon: '🚨', color: '#dc2626' }
            };
            return configs[status] || configs[1];
        }

        // Check for alert devices and update popup visibility
        function checkAlertDevices() {
            const alertDevices = document.querySelectorAll('.device-card[data-status="3"], .device-card[data-status="5"]');
            const alertPopup = document.getElementById('alertPopup');
            const alertFlatNo = document.getElementById('alertFlatNo');
            if (alertPopup && alertFlatNo) {
                const currentCount = alertDevices.length;
                
                if (currentCount > 0) {
                    // Display first alert device's flat number and status label
                    const firstAlertDevice = alertDevices[0];
                    const flatNo = firstAlertDevice.getAttribute('data-flatno') || firstAlertDevice.textContent.trim();
                    alertFlatNo.textContent = flatNo;
                    const statusText = firstAlertDevice.dataset.statustext || 'Alert';
                    const alertTextElement = document.getElementById('alertText');
                    if (alertTextElement) {
                        alertTextElement.textContent = `${statusText} Device`;
                    }
                    
                    // New alert devices detected
                    if (currentCount > previousAlertCount) {
                        // New devices appeared
                        hasExistingTicket = false;
                        alertTicketId = null;
                    }
                    previousAlertCount = currentCount;
                    alertPopup.style.display = 'flex';
                    // Play buzzer sound when popup is shown
                    playBuzzer();
                } else {
                    // No alert devices - hide popup
                    previousAlertCount = 0;
                    hasExistingTicket = false;
                    alertTicketId = null;
                    alertPopup.style.display = 'none';
                    // Stop buzzer sound when popup is hidden
                    stopBuzzer();
                }
            }
        }

        // Start auto-refresh every 3 seconds
        setInterval(updateCommunityDashboard, 3000);

        // Initial update after page load
        setTimeout(() => {
            updateCommunityDashboard();
            checkAlertDevices();
        }, 1000);

        // Initialize carousel
        document.addEventListener('DOMContentLoaded', function() {
            totalSlides = document.querySelectorAll('.carousel-slide').length;
            initCarousel();
        });
    </script>
</body>
</html>
