            <h2 style="color: #fff; font-size: 20px; font-weight: 800; margin: 0 12px 0 0; letter-spacing: 1px;">Megha Smart</h2>
            <button id="sidebar-toggle-btn" title="Toggle Sidebar" style="margin-left: auto; background: #23284a; border: none; color: #fff; font-size: 1.5em; cursor: pointer; padding: 6px 14px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.10); transition: background 0.2s;">
