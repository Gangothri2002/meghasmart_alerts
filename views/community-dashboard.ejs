    <meta charset="UTF-8">
    <!-- Buzzer sound for alert popup -->
    <audio id="buzzerAudio" src="/buzzer.mp3"></audio>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= community.customerName %> - Community Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/community.css">
    <style>
        /* Device Grid Layout - 14 circles per row for 7 rows */
        .devices-grid {
            display: grid;
            grid-template-columns: repeat(14, minmax(50px, 1fr));
            gap: 6px;
            padding: 12px;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            min-height: auto;
            justify-items: center;
            border-radius: 16px;
            border: 1px solid rgba(226,232,240,0.9);
        }

        .community-main {
            display: flex;
            flex-direction: column;
            min-height: calc(100vh - 20px);
            padding: 8px 12px 12px;
        }

        .community-card.dashboard-card {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 0;
            margin: 24px 0 0;
            padding: 12px;
            border-radius: 22px;
            background: rgba(255,255,255,0.96);
            border: 1px solid rgba(226,232,240,0.9);
        }

        .devices-container {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            margin-top: 10px;
        }

        .carousel-container {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .carousel-wrapper,
        .carousel-slide {
            flex: 1;
            min-height: 0;
        }

        .devices-summary {
            margin: 0;
            padding: 12px 14px;
            border-radius: 16px;
        }

        .carousel-indicators {
            display: flex;
            justify-content: center;
            gap: 8px;
            padding: 10px 0 0;
        }

        /* Device Status Circle/Square */
        .device-card {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.35);
            font-weight: 700;
            font-size: 11px;
            text-align: center;
            line-height: 1.1;
            color: white;
            backdrop-filter: blur(10px);
            background: #6b7280; /* Default gray for unknown status */
        }

        .device-circle-content {
            font-size: 11px;
            font-weight: 800;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
        }

        /* Status-based colors with enhanced gradients */
        .device-card.status-initialize {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 50%, #1d4ed8 100%);
            box-shadow: 0 4px 16px rgba(59, 130, 246, 0.35), 0 2px 8px rgba(37, 99, 235, 0.2);
        }

        .device-card.status-initialize:hover {
            transform: scale(1.15) translateY(-5px) rotate(2deg);
            box-shadow: 0 12px 28px rgba(59, 130, 246, 0.4), 0 6px 14px rgba(37, 99, 235, 0.25);
            border-color: rgba(255, 255, 255, 0.8);
        }

        .device-card.status-no-communication,
        .device-card.status-offline {
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #d97706 100%);
            box-shadow: 0 6px 20px rgba(251, 191, 36, 0.35), 0 3px 10px rgba(251, 191, 36, 0.25);
        }

        .device-card.status-no-communication:hover,
        .device-card.status-offline:hover {
            transform: scale(1.15) translateY(-5px) rotate(1deg);
            box-shadow: 0 12px 28px rgba(251, 191, 36, 0.4), 0 6px 14px rgba(251, 191, 36, 0.3);
            border-color: rgba(255, 255, 255, 0.8);
        }

        .device-card.status-good,
        .device-card.status-online {
            background: linear-gradient(135deg, #10b981 0%, #059669 50%, #047857 100%);
            box-shadow: 0 4px 16px rgba(16, 185, 129, 0.35), 0 2px 8px rgba(16, 185, 129, 0.2);
        }

        .device-card.status-good:hover,
        .device-card.status-online:hover {
            transform: scale(1.15) translateY(-5px) rotate(2deg);
            box-shadow: 0 12px 28px rgba(16, 185, 129, 0.4), 0 6px 14px rgba(16, 185, 129, 0.25);
            border-color: rgba(255, 255, 255, 0.8);
        }

        .device-card.status-alert,
        .device-card.status-panic {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 50%, #b91c1c 100%);
            box-shadow: 0 6px 20px rgba(239, 68, 68, 0.35), 0 3px 10px rgba(239, 68, 68, 0.25);
            /* animation removed - status alerts now static */
        }

        .device-card.status-alert:hover,
        .device-card.status-panic:hover {
            transform: scale(1.15) translateY(-5px) rotate(-2deg);
            box-shadow: 0 12px 28px rgba(239, 68, 68, 0.45), 0 6px 14px rgba(239, 68, 68, 0.3);
            border-color: rgba(255, 255, 255, 0.8);
        }

        /* Animation removed for static display */
        /* Removed keyframes - no longer used */

        /* Enhanced status tooltip */
        .device-card::after {
            content: attr(data-statustext);
            position: absolute;
            bottom: -36px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 41, 59, 0.95) 100%);
            color: white;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            opacity: 0;
            transition: all 0.3s ease;
            pointer-events: none;
            z-index: 10;
            text-transform: capitalize;
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .device-card:hover::after {
            opacity: 1;
            transform: translateX(-50%) translateY(2px);
        }

        /* Responsive design for smaller screens */
        @media (max-width: 768px) {
            .devices-grid {
                grid-template-columns: repeat(10, minmax(40px, 1fr));
                gap: 8px;
                padding: 14px;
            }

            .device-card {
                width: 48px;
                height: 48px;
                font-size: 10px;
            }

            .device-card::after {
                bottom: -28px;
                padding: 5px 10px;
                font-size: 10px;
            }
            
            .search-filter-bar {
                flex-direction: column;
                gap: 10px;
                padding: 12px 16px;
                margin: 0 -18px 16px -18px;
            }
            
            .search-filter-bar input,
            .search-filter-bar select {
                width: 100%;
            }
            
            .dashboard-card-header {
                flex-direction: column;
                margin-bottom: 16px;
            }
            
            .devices-footer {
                padding: 10px 16px;
            }
        }

        @media (max-width: 480px) {
            .devices-grid {
                grid-template-columns: repeat(7, minmax(35px, 1fr));
                gap: 6px;
                padding: 12px;
            }

            .device-card {
                width: 42px;
                height: 42px;
                font-size: 10px;
            }

            .device-card::after {
                bottom: -26px;
                padding: 4px 8px;
                font-size: 9px;
            }
            
            .search-filter-bar {
                flex-direction: column;
                padding: 10px 14px;
                margin: 0 -14px 12px -14px;
            }

            .search-filter-bar .device-count-inline {
                width: 100%;
                min-width: auto;
                margin: 0;
            }
            
            .search-filter-bar .alert-popup {
                width: 100%;
                min-width: auto;
                margin: 0;
            }
            
            .empty-state {
                padding: 36px 18px;
            }
            
            .devices-footer {
                padding: 8px 12px;
                font-size: 12px;
            }
        }

        /* Header Center Popup */
        .header-center-popup {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 20px;
        }

        /* Search Bar Styling - Compact and Attractive */
        .search-filter-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 12px 18px;
            background: white;
            border-bottom: 1px solid #e2e8f0;
            margin: 0 -24px 16px -24px;
            box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.02);
            border-radius: 0;
        }

        .search-filter-bar input {
            flex: 1;
            padding: 8px 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 13px;
            transition: all 0.3s ease;
            background: white;
            font-weight: 500;
        }

        .device-count-inline {
            flex: 0 0 auto;
            padding: 10px 14px;
            min-width: 170px;
            text-align: center;
            background: #f8fafc;
            color: #374151;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
        }

        .alert-popup {
            padding: 8px 20px;
            min-width: 400px;
            text-align: center;
            background: linear-gradient(135deg, #ffcccc 0%, #ffaaaa 100%);
            color: #b91c1c;
            border: 2px solid #ff4444;
            border-radius: 20px;
            font-size: 16px;
            font-weight: 700;
            white-space: nowrap;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            box-shadow: 0 4px 12px rgba(255, 68, 68, 0.4), 0 0 20px rgba(255, 68, 68, 0.6);
            animation: pulse 1s infinite;
            backdrop-filter: blur(8px);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .alert-popup::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            animation: shimmer 2s infinite;
        }

        .alert-popup:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(255, 68, 68, 0.5), 0 0 25px rgba(255, 68, 68, 0.7), 0 0 35px rgba(255, 68, 68, 0.9);
        }

        .alert-icon {
            font-size: 20px;
            margin-right: 10px;
            filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.2));
        }

        .alert-text {
            font-size: 20px;
            font-weight: 800;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
            margin-left: 4px;
        }

        @keyframes pulse {
            0%, 100% {
                opacity: 1;
                box-shadow: 0 4px 12px rgba(255, 68, 68, 0.4), 0 0 20px rgba(255, 68, 68, 0.6), 0 0 30px rgba(255, 68, 68, 0.8);
            }
            50% {
                opacity: 0.5;
                box-shadow: 0 4px 12px rgba(255, 68, 68, 0.4), 0 0 30px rgba(255, 68, 68, 0.3), 0 0 40px rgba(255, 68, 68, 0.5);
            }
        }

        @keyframes shimmer {
            0% {
                left: -100%;
            }
            100% {
                left: 100%;
            }
        }

        .search-filter-bar input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            transform: translateY(-1px);
        }

        .search-filter-bar select {
            padding: 8px 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 13px;
            background: white;
            cursor: pointer;
            transition: all 0.3s ease;
            min-width: 120px;
            font-weight: 500;
        }

        .search-filter-bar select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            transform: translateY(-1px);
        }

        /* Carousel Styles */
        .carousel-container {
            position: relative;
            overflow: hidden;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            padding-bottom: 0;
        }

        .carousel-wrapper {
            position: relative;
            width: 100%;
            height: auto;
            padding-bottom: 0;
        }

        .carousel-slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
        }

        .carousel-slide.active {
            opacity: 1;
            visibility: visible;
            position: relative;
        }

        .carousel-indicators {
            position: absolute;
            bottom: 4px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 8px;
            z-index: 10;
        }

        .indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            transition: all 0.3s ease;
            border: 2px solid rgba(0, 0, 0, 0.2);
        }

        .indicator.active {
            background: #667eea;
            border-color: #667eea;
            transform: scale(1.2);
        }

        .indicator:hover {
            background: rgba(255, 255, 255, 0.8);
            transform: scale(1.1);
        }

        .profile-menu-container {
            position: relative;
        }

        .profile-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 13px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        }

        .profile-trigger:hover {
            border-color: #667eea;
            box-shadow: 0 6px 16px rgba(102, 126, 234, 0.15);
            transform: translateY(-2px);
        }

        .profile-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 14px;
            box-shadow: 0 2px 8px rgba(102, 126, 234, 0.25);
            flex-shrink: 0;
        }

        .profile-email {
            font-size: 13px;
            color: #374151;
            font-weight: 500;
        }

        .profile-dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            min-width: 200px;
            margin-top: 8px;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.3s ease;
        }

        .profile-dropdown.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            color: #374151;
            text-decoration: none;
            font-size: 13px;
            transition: all 0.2s ease;
            border-bottom: 1px solid #f3f4f6;
        }

        .profile-dropdown-item:last-child {
            border-bottom: none;
        }

        .profile-dropdown-item:hover {
            background-color: #f8fafc;
            color: #667eea;
            padding-left: 20px;
        }

        .profile-dropdown-item.danger:hover {
            background-color: #fef2f2;
            color: #dc2626;
        }
    </style>
</head>
